<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows + UseWPF, not plain net8.0: most classes under test (SolarCalculator,
         ScheduleCurve, ColorTemperature, etc.) are pure math with no Win32/WPF/WinForms
         dependency, but MigraineModeController itself depends on System.Windows.Media.Color
         and System.Windows.Threading.DispatcherTimer directly (not just its now-fakeable
         GammaControllerManager/OverlayController dependencies, see HardwareTargets.cs),
         so testing it at all requires the Windows Desktop runtime here too. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Underscores make xUnit test names readable as behavior specifications. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\MonitorWellness\Core\SolarCalculator.cs" />
    <Compile Include="..\..\src\MonitorWellness\Core\ScheduleCurve.cs" />
    <Compile Include="..\..\src\MonitorWellness\Core\ColorTemperature.cs" />
    <Compile Include="..\..\src\MonitorWellness\Core\GeocodingService.cs" />
