<Window x:Class="MonitorWellness.BreakFocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="20-second focus break" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="20-second focus break" FontWeight="Bold" FontSize="18"
                   AutomationProperties.Name="20-second focus break"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,12" Text="Look at something comfortably distant. This is optional — you can close it at any time."
                   TextWrapping="Wrap" Foreground="{DynamicResource MW.HelperText}"/>
        <TextBlock x:Name="CountdownText" Grid.Row="2" HorizontalAlignment="Center" FontSize="32" FontWeight="SemiBold"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Seconds remaining"/>
        <Button Grid.Row="3" Content="Done" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="16,5"
                IsCancel="True" Click="Done_Click" AutomationProperties.Name="Close focus break"/>
    </Grid>
</Window>
