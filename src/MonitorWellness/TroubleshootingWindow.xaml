<Window x:Class="MonitorWellness.TroubleshootingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Troubleshooting"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <!--
        Consolidates the conflict cases the app already detects and explains well in a one-off
        balloon notification (fullscreen-blocks-overlay, f.lux conflict, hotkey conflict, HDR
        present) into one place a user can come back to later, instead of only ever seeing each
        one once at the moment it's detected. See
        MonitorWellness_UX_Accessibility_Audit.html §2.1/§2.6/§3.5/§6 (P1).
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Troubleshooting" FontWeight="Bold" FontSize="18" Margin="0,0,0,12"
                   AutomationProperties.HeadingLevel="Level1"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Migraine relief doesn't seem to be showing" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
            <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource MW.SafetyText}" Margin="0,0,0,12">
                A full-screen app (a game, video, or presentation) may be hiding the dim overlay.
                Try switching to windowed mode, or Alt+Tab away, to see the full effect.
            </TextBlock>

            <TextBlock Text="Colors flicker, or keep reverting to normal" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
            <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource MW.SafetyText}" Margin="0,0,0,12">
                Another screen-color app (such as f.lux, or Windows Night Light) may be running
                at the same time. Using two at once can cause flickering — try closing one of
                them.
            </TextBlock>

            <TextBlock Text="The Migraine Mode hotkey doesn't do anything" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
            <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource MW.SafetyText}" Margin="0,0,0,12">
                Your shortcut may already be claimed by another app. Use the tray icon or tray
                menu to trigger Migraine Mode instead, or pick a different shortcut in Settings.
            </TextBlock>

            <TextBlock Text="Colors look wrong on one screen" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
            <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource MW.SafetyText}" Margin="0,0,0,12">
                If that screen has Windows HDR turned on, color adjustments haven't been tested
                against HDR displays and may not look right — try turning HDR off for that
                monitor.
            </TextBlock>

            <TextBlock Text="Something else is wrong, or the app seems stuck" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
            <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource MW.SafetyText}">
                Check Diagnostics in the tray menu for auto-start status and a log file that can
                help track down what happened, or just restart Monitor Wellness.
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Width="90" Padding="4" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
