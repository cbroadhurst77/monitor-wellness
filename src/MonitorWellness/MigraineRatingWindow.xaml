<Window x:Class="MonitorWellness.MigraineRatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor Wellness" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="How did that feel?" FontWeight="Bold" Margin="0,0,0,4"
                    AutomationProperties.Name="How did Migraine Mode feel just now?"/>
        <TextBlock Grid.Row="1" Text="Optional — this helps you track what's working for you. 1 = not helpful, 5 = very helpful. Stays fully local — see Settings' privacy note." FontSize="13" Foreground="DimGray" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="Rating1Button" Content="1" Width="34" Margin="0,0,4,0" Click="RatingButton_Click" AutomationProperties.Name="Rate 1 out of 5"/>
            <Button x:Name="Rating2Button" Content="2" Width="34" Margin="0,0,4,0" Click="RatingButton_Click" AutomationProperties.Name="Rate 2 out of 5"/>
            <Button x:Name="Rating3Button" Content="3" Width="34" Margin="0,0,4,0" Click="RatingButton_Click" AutomationProperties.Name="Rate 3 out of 5"/>
            <Button x:Name="Rating4Button" Content="4" Width="34" Margin="0,0,4,0" Click="RatingButton_Click" AutomationProperties.Name="Rate 4 out of 5"/>
            <Button x:Name="Rating5Button" Content="5" Width="34" Margin="0,0,12,0" Click="RatingButton_Click" AutomationProperties.Name="Rate 5 out of 5"/>
            <Button x:Name="SkipButton" Content="Skip" Padding="6,2" Click="Skip_Click"/>
        </StackPanel>

        <Button x:Name="DontAskAgainButton" Grid.Row="3" Content="Don't ask again" HorizontalAlignment="Center"
                Margin="0,10,0,0" Padding="4,2" BorderThickness="0" Background="Transparent"
                Foreground="DimGray" FontSize="12" Cursor="Hand" Click="DontAskAgain_Click"
                AutomationProperties.Name="Stop asking for a rating after Migraine Mode"/>
    </Grid>
</Window>
