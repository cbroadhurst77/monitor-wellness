<Window x:Class="MonitorWellness.BreakPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time for a break" Width="340" SizeToContent="Height"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Time for a break" FontWeight="Bold" FontSize="16"
                   AutomationProperties.Name="Time for a break"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MW.HelperText}"
                   Text="Look at something about 20 feet away for 20 seconds."/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Start 20 seconds" Padding="12,4" IsDefault="True" Click="Start_Click"
                    AutomationProperties.Name="Start the 20-second break"/>
            <Button Content="In 5 minutes" Padding="12,4" Margin="8,0,0,0" Click="Snooze_Click"
                    AutomationProperties.Name="Remind me again in 5 minutes"/>
            <Button Content="Skip" Padding="12,4" Margin="8,0,0,0" IsCancel="True" Click="Skip_Click"
                    AutomationProperties.Name="Skip this reminder"/>
        </StackPanel>
    </Grid>
</Window>
