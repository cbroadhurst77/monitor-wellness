<Window x:Class="MonitorWellness.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Monitor Wellness"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <!--
        Rewritten from four dense paragraphs in one modal into short, single-idea steps (what
        it does -> Migraine Mode & hotkey -> safety note -> location prompt), one screen at a
        time, so a first-time read takes seconds rather than requiring a full page of prose up
        front. See MonitorWellness_UX_Accessibility_Audit.html §2.3/§3.1/§6 (P1).
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StepProgressText" Grid.Row="0" FontSize="12" Foreground="{DynamicResource MW.HelperText}" Margin="0,0,0,4"/>
        <TextBlock x:Name="StepTitleText" Grid.Row="1" FontWeight="Bold" FontSize="18" Margin="0,0,0,14"
                   AutomationProperties.HeadingLevel="Level1"/>

        <Grid Grid.Row="2" MinHeight="90">
            <StackPanel x:Name="Step1Panel">
                <TextBlock TextWrapping="Wrap" FontSize="14">
                    Monitor Wellness gently warms and dims your screen as the day goes on,
                    following sunrise and sunset where you are.
                </TextBlock>
            </StackPanel>

            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" FontSize="14">
                    <Run Text="Migraine Mode"/> instantly switches your screen to a muted green
                    tint that many people with migraines find soothing. Trigger it with a single
                    click on the tray icon, from the tray menu, or the
                    <Run Text="Ctrl+Alt+Shift+M" FontWeight="SemiBold"/> hotkey — you can change
                    the shortcut later in Settings.
                </TextBlock>
            </StackPanel>

            <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                <Border Background="#FFFDF3D0" BorderBrush="#FFE0C25A" BorderThickness="1" Padding="12" CornerRadius="3">
                    <!-- Foreground fixed, not theme-following: this note box's own light
                         yellow Background never changes with the theme, so its text can't be
                         allowed to inherit the window's dark-mode Foreground either, or it goes
                         near-white-on-pale-yellow and becomes unreadable. Confirmed exactly this
                         happening live in AboutWindow's identical note box. -->
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#FF3D3D3D">
                        This is not a medical device and isn't a substitute for professional
                        medical care. If you experience migraines, please talk to a doctor about
                        treatment — use this as one comfort tool alongside that, not instead of
                        it.
                    </TextBlock>
                </Border>
            </StackPanel>

            <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10">
                    Everything is controlled from the tray icon near your clock — right-click it
                    any time for Settings, Pause Schedule, or Migraine Mode.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14">
                    One thing worth doing now: Monitor Wellness defaults to London's sunrise and
                    sunset times. Set your real location so the schedule matches where you
                    actually are.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,10,0,0">
                    If a display ever becomes hard to use, press Ctrl+Alt+Shift+R to restore the
                    normal screen immediately and pause the schedule for an hour.
                </TextBlock>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BackButton" Content="Back" Width="80" Padding="4" Margin="0,0,8,0" Click="Back_Click" Visibility="Collapsed"/>
            <Button x:Name="NextButton" Content="Next" Width="80" Padding="4" Click="Next_Click"
                    AutomationProperties.Name="Next step"/>
            <Button x:Name="SkipButton" Content="Skip for now (uses London times)" Padding="8,4" Margin="0,0,8,0" Click="Dismiss_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Skip setting a location for now — uses London sunrise and sunset times"/>
            <Button x:Name="SetLocationButton" Content="Set my location now" Padding="8,4" Click="OpenSettings_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Set my location now and open Settings"/>
        </StackPanel>
    </Grid>
</Window>
