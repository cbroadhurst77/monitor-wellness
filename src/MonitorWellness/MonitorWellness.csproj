<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0, not plain net8.0-windows, specifically to get the WinRT
         projection for Windows.Devices.Sensors.LightSensor (ambient-light-adaptive
         brightness) without adding any NuGet or Windows App SDK dependency: the .NET SDK
         generates that projection automatically for this TFM. Still runs fine on the same
         Windows versions as before; this only changes what APIs are visible to the compiler. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>MonitorWellness</RootNamespace>
    <AssemblyName>MonitorWellness</AssemblyName>
    <Platforms>x64</Platforms>
    <!-- Single source of truth for the app's version. Core/UpdateChecker.cs reads this via
         Assembly.GetExecutingAssembly().GetName().Version to compare against the latest GitHub
         release tag, and installer/MonitorWellness.iss's MyAppVersion must be bumped to match
         by hand on each release (Inno Setup can't read this file). Was previously unset here,
         defaulting to the SDK's own 1.0.0.0, while the installer separately said 0.1.0: a
         silent mismatch, since nothing ever compared the two. -->
    <Version>0.2.2</Version>
    <!-- WFAC010 assumes a WinForms-owned entry point (Application.SetHighDpiMode). This app
         is WPF-hosted, so Per-Monitor-V2 is declared in app.manifest instead - see the
         comment there. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded (not Content/CopyToOutputDirectory) so these survive a self-contained
         single-file publish: Content files are not extracted alongside a single-file exe at
         runtime, which broke tray icon loading (DirectoryNotFoundException) the first time
         this was published as one file. Embedded resources are compiled directly into the
         assembly, so there is no separate file to go missing. -->
    <EmbeddedResource Include="Assets\migraine_on.ico" LogicalName="MonitorWellness.Assets.migraine_on.ico" />
    <EmbeddedResource Include="Assets\migraine_off.ico" LogicalName="MonitorWellness.Assets.migraine_off.ico" />
    <!-- CC BY-SA 3.0, Strebe. See ATTRIBUTIONS.md -->
    <EmbeddedResource Include="Assets\worldmap.jpg" LogicalName="MonitorWellness.Assets.worldmap.jpg" />
  </ItemGroup>

</Project>
