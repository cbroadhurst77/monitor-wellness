<Window x:Class="MonitorWellness.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Monitor Wellness"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <!--
        Split out of the old "Help / About..." menu item, which previously just reopened the
        full first-run onboarding wizard (wrong voice for someone looking something up later).
        This is the short, "what is this" reference version; TroubleshootingWindow.xaml is the
        separate "how do I fix X" version. See
        MonitorWellness_UX_Accessibility_Audit.html §2.1/§2.6/§3.5/§6 (P1).
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Monitor Wellness" FontWeight="Bold" FontSize="18" Margin="0,0,0,12"
                   AutomationProperties.HeadingLevel="Level1"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10">
                Monitor Wellness gently warms and dims your screen as the day goes on, following
                sunrise and sunset where you are. Migraine Mode is an instant personal comfort
                option using a muted green tint informed by published migraine-light research
                (see Settings for details); it does not promise clinical relief.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10">
                The tray menu includes Diagnostics → Display Capability Passport for a local,
                read-only explanation of monitor and brightness capabilities, plus Emergency
                Restore Screen (Ctrl+Alt+Shift+R) if you need to recover the normal display.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource MW.SafetyText}">
                Nothing is sent anywhere except an optional, one-off location search in
                Settings, and an optional check for new versions (both off unless you turn them
                on) — everything else stays on this PC. No telemetry, no accounts.
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="2" Background="#FFFDF3D0" BorderBrush="#FFE0C25A" BorderThickness="1" Padding="12" CornerRadius="3" Margin="0,0,0,12">
            <!-- Foreground fixed, not theme-following: this note box's own light yellow
                 Background never changes with the theme, so its text can't inherit the
                 window's dark-mode Foreground either, or it goes near-white-on-pale-yellow
                 and becomes unreadable, exactly as reported live from the tray menu. -->
            <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#FF3D3D3D">
                This is not a medical device and isn't a substitute for professional medical
                care. If you experience migraines, please talk to a doctor about treatment — use
                this as one comfort tool alongside that, not instead of it.
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="90" Padding="4" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
