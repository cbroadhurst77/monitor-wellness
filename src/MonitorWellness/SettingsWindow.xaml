<Window x:Class="MonitorWellness.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor Wellness Settings"
        Width="480" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Location" FontWeight="Bold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Latitude"/>
                        <TextBox x:Name="LatitudeBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Longitude"/>
                        <TextBox x:Name="LongitudeBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Day / Night Schedule" FontWeight="Bold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Day color temp (K)"/>
                        <TextBox x:Name="DayKelvinBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Night color temp (K)"/>
                        <TextBox x:Name="NightKelvinBox"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Gamma ramp is only reliable in the ~3300K-6500K range on most hardware — see IMPLEMENTATION.md." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Day brightness (0-1)"/>
                        <TextBox x:Name="DayBrightnessBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Night brightness (0-1)"/>
                        <TextBox x:Name="NightBrightnessBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Migraine Mode" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Overlay color (hex, e.g. #321408)"/>
                    <TextBox x:Name="MigraineColorBox"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Overlay opacity (0-1)"/>
                    <TextBox x:Name="MigraineOpacityBox"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Toggle hotkey (click box, then press a key combo)"/>
                    <TextBox x:Name="HotkeyBox" IsReadOnly="True" Background="#FFF0F0F0"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                </StackPanel>
                <TextBlock Text="Must include at least one of Ctrl/Alt/Shift." FontSize="10" Foreground="Gray" Margin="0,0,0,12"/>

                <TextBlock Text="Monitors" FontWeight="Bold" Margin="0,0,0,4"/>
                <Button x:Name="IdentifyButton" Content="Identify Monitors" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,8" Click="IdentifyButton_Click"/>
                <ItemsControl x:Name="MonitorsList"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Padding="4" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="80" Padding="4" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
