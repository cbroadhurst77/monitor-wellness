<Window x:Class="MonitorWellness.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor Wellness Settings"
        Width="560" Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Location" FontWeight="Bold" Margin="0,0,0,4"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LocationSearchBox" Grid.Column="0" Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Town, city, postcode/zip, or place name"/>
                    <Button x:Name="FindLocationButton" Grid.Column="1" Content="Find" Padding="12,4" Click="FindLocationButton_Click"/>
                </Grid>
                <TextBlock x:Name="LocationSearchStatus" FontSize="10" Foreground="Gray" Margin="0,0,0,6" TextWrapping="Wrap"/>

                <Border BorderBrush="#FFAAAAAA" BorderThickness="1" Margin="0,0,0,4" HorizontalAlignment="Left">
                    <Grid x:Name="MapContainer" Width="440" Height="222" ClipToBounds="True"
                          MouseLeftButtonDown="MapContainer_MouseLeftButtonDown" Cursor="Hand">
                        <Image x:Name="MapImage" Stretch="Fill"/>
                        <Canvas x:Name="MapMarkerCanvas" IsHitTestVisible="False">
                            <Ellipse x:Name="MapMarker" Width="10" Height="10" Fill="#FFE84B3C" Stroke="White" StrokeThickness="1.5"/>
                        </Canvas>
                    </Grid>
                </Border>
                <TextBlock Text="Click the map to set your location roughly — precise enough for sunrise/sunset timing, which barely changes over tens of km." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Latitude"/>
                        <TextBox x:Name="LatitudeBox" TextChanged="LatLongBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Longitude"/>
                        <TextBox x:Name="LongitudeBox" TextChanged="LatLongBox_TextChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="SunTimesText" FontSize="11" Foreground="DimGray" Margin="0,0,0,12"/>

                <TextBlock Text="Day / Night Schedule" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Dragging a slider previews it on your real screens right now — nothing is saved until you click Save, and Cancel leaves everything untouched." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Day color temp"/>
                        <Slider x:Name="DayKelvinSlider" Minimum="2000" Maximum="10000" TickFrequency="50"
                                IsSnapToTickEnabled="True" ValueChanged="DaySlider_ValueChanged"/>
                        <TextBlock x:Name="DayKelvinLabel" HorizontalAlignment="Center" FontSize="11" Foreground="DimGray"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Night color temp"/>
                        <Slider x:Name="NightKelvinSlider" Minimum="2000" Maximum="10000" TickFrequency="50"
                                IsSnapToTickEnabled="True" ValueChanged="NightSlider_ValueChanged"/>
                        <TextBlock x:Name="NightKelvinLabel" HorizontalAlignment="Center" FontSize="11" Foreground="DimGray"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="KelvinSafetyWarning" FontSize="10" Foreground="#FFB03030" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>
                <TextBlock Text="Gamma ramp is only reliable in the ~3300K-6500K range on most hardware — see IMPLEMENTATION.md." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Day brightness"/>
                        <Slider x:Name="DayBrightnessSlider" Minimum="0" Maximum="1" ValueChanged="DaySlider_ValueChanged"/>
                        <TextBlock x:Name="DayBrightnessLabel" HorizontalAlignment="Center" FontSize="11" Foreground="DimGray"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Night brightness"/>
                        <Slider x:Name="NightBrightnessSlider" Minimum="0" Maximum="1" ValueChanged="NightSlider_ValueChanged"/>
                        <TextBlock x:Name="NightBrightnessLabel" HorizontalAlignment="Center" FontSize="11" Foreground="DimGray"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Migraine Mode" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Overlay color (hex, e.g. #173620)"/>
                    <TextBox x:Name="MigraineColorBox" TextChanged="MigrainePreview_Changed"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Overlay opacity"/>
                    <Slider x:Name="MigraineOpacitySlider" Minimum="0" Maximum="1" ValueChanged="MigrainePreview_Changed"/>
                    <TextBlock x:Name="MigraineOpacityLabel" HorizontalAlignment="Center" FontSize="11" Foreground="DimGray"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Contrast reduction (a distinct comfort lever from color/brightness)"/>
                    <Slider x:Name="MigraineContrastSlider" Minimum="0" Maximum="0.3" ValueChanged="MigrainePreview_Changed"/>
                    <TextBlock x:Name="MigraineContrastLabel" HorizontalAlignment="Center" FontSize="11" Foreground="DimGray"/>
                </StackPanel>
                <TextBlock Text="Color/opacity/contrast changes above preview live too — this is what your screen will look like when migraine mode is triggered. The hotkey/tray toggle still work normally while this window is open." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Auto-off after (minutes, 0 = never — a real migraine can last hours, so this is off by default)"/>
                    <Slider x:Name="MigraineAutoRevertSlider" Minimum="0" Maximum="240" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="MigraineAutoRevertSlider_ValueChanged"/>
                    <TextBlock x:Name="MigraineAutoRevertLabel" HorizontalAlignment="Center" FontSize="11" Foreground="DimGray"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Toggle hotkey (click box, then press a key combo)"/>
                    <TextBox x:Name="HotkeyBox" IsReadOnly="True" Background="#FFF0F0F0"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                </StackPanel>
                <TextBlock Text="Must include at least one of Ctrl/Alt/Shift." FontSize="10" Foreground="Gray" Margin="0,0,0,12"/>

                <TextBlock Text="Monitors" FontWeight="Bold" Margin="0,0,0,4"/>
                <Button x:Name="IdentifyButton" Content="Identify Monitors" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,8" Click="IdentifyButton_Click"/>
                <ItemsControl x:Name="MonitorsList"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Padding="4" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="80" Padding="4" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
